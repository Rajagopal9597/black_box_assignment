# ---- Postgres ----
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=filestore
# Port Postgres is exposed on, on your machine. 5433 (not 5432) so it doesn't clash with a
# locally installed Postgres. Change it and the two URLs below together.
POSTGRES_PORT=5433
# Used by the API. Inside docker-compose the host is "postgres"; for local `npm run dev` use localhost.
DATABASE_URL=postgres://app:app@localhost:5433/filestore

# ---- Object storage (MinIO locally, any S3-compatible store in prod) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ---- API ----
NODE_ENV=development
API_PORT=3000
# Public origin of the web app (used for CORS and for building share/invite links)
APP_ORIGIN=http://localhost:8080
SESSION_TTL_HOURS=168
# Set to true when serving over HTTPS (adds the Secure flag to the session cookie)
COOKIE_SECURE=false
INVITE_TTL_DAYS=7
MAX_UPLOAD_BYTES=26214400

# ---- Tests ----
# Created automatically by docker/postgres/init.sql. Tests migrate and truncate this DB.
TEST_DATABASE_URL=postgres://app:app@localhost:5433/filestore_test
